{
  "name": "itiscoming",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "expo lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
