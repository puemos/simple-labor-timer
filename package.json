    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22 <26"
