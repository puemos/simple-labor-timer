{
  "name": "simple-labor-timer",
  "version": "1.0.0",
  "description": "A free, local-first contraction timer for iOS and Android.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/puemos/simple-labor-timer.git"
  },
  "bugs": {
    "url": "https://github.com/puemos/simple-labor-timer/issues"
  },
  "homepage": "https://puemos.github.io/simple-labor-timer/",
  "packageManager": "pnpm@10.24.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "screenshots:ios": "tsx scripts/generate-ios-screenshots.ts",
    "lint": "expo lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "release:verify": "pnpm exec expo install --check && pnpm run verify",
    "release:metadata:ios": "eas metadata:push",
    "release:build": "eas build --platform all --profile production",
    "release:submit:android": "eas submit --platform android --profile production",
    "release:submit:ios": "eas submit --platform ios --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-segmented-control/segmented-control": "^2.5.7",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.22",
    "expo-haptics": "~15.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.8",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "i18next": "^26.0.10",
    "lucide-react-native": "^1.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.7",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "eas-cli": "^18.11.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22 <26"
  }
}
