{
  "cli": {
    "version": "18.11.0",
    "requireCommit": true,
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.21.1",
      "pnpm": "10.16.1",
      "corepack": true,
      "developmentClient": true,
      "distribution": "internal",
      "credentialsSource": "remote",
      "environment": "development"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "node": "22.21.1",
      "pnpm": "10.16.1",
      "corepack": true,
      "distribution": "store",
      "credentialsSource": "remote",
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "applicationId": "app.simplelabortimer",
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "bundleIdentifier": "app.simplelabortimer",
        "ascAppId": "6768247052",
        "sku": "app.simplelabortimer",
        "metadataPath": "./store.config.json"
      }
    }
  }
}
